{
  "name": "yourhome",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter reviewer-web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write apps packages scripts .github eslint.config.mjs .prettierrc.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps packages scripts .github eslint.config.mjs .prettierrc.json package.json pnpm-workspace.yaml",
    "smoke:api": "pnpm --filter api smoke:disposable",
    "seed:demo": "pnpm --filter api seed:demo",
    "check:platform-gates": "powershell -ExecutionPolicy Bypass -File ./scripts/check-platform-gates.ps1",
    "evidence:parity": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-parity-evidence.ps1",
    "evidence:web": "powershell -ExecutionPolicy Bypass -File ./scripts/capture-web-parity-evidence.ps1",
    "evidence:mobile:verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-mobile-evidence.ps1 -AllowMissing",
    "evidence:mobile:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-mobile-evidence-links.ps1",
    "evidence:mobile:verify:m53": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-mobile-evidence.ps1 -Milestone m53 -AllowMissing",
    "evidence:mobile:sync:m53": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-mobile-evidence-links.ps1 -Milestone m53",
    "evidence:android:capture:m53": "powershell -ExecutionPolicy Bypass -File ./scripts/capture-android-evidence-adb.ps1 -Milestone m53",
    "evidence:android:devices": "powershell -ExecutionPolicy Bypass -File ./scripts/capture-android-evidence-adb.ps1 -ListDevices",
    "check:mobile-config": "powershell -ExecutionPolicy Bypass -File ./scripts/check-mobile-config.ps1",
    "go:android": "powershell -ExecutionPolicy Bypass -File ./scripts/go-android.ps1",
    "go:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/go-android.ps1 -Reset",
    "test:run": "powershell -ExecutionPolicy Bypass -File ./scripts/test-run.ps1",
    "test:run:reset": "powershell -ExecutionPolicy Bypass -File ./scripts/test-run.ps1 -Reset",
    "test:run:check": "powershell -ExecutionPolicy Bypass -File ./scripts/test-run-test.ps1",
    "test:close": "powershell -ExecutionPolicy Bypass -File ./scripts/test-close.ps1",
    "test:close:check": "powershell -ExecutionPolicy Bypass -File ./scripts/test-close-test.ps1",
    "test:migration-integrity": "node scripts/verify-migration-integrity.cjs",
    "test:email-security": "pnpm --filter api test:email-security",
    "test:jwt-security": "pnpm --filter api test:jwt-security",
    "test:quality-gates": "node scripts/quality-gates-test.cjs",
    "test:s3-security": "pnpm --filter api test:s3-security",
    "test:static-file-security": "pnpm --filter api test:static-file-security",
    "test:prisma-config": "pnpm --filter api test:prisma-config",
    "test:prisma": "pnpm --filter api test:prisma",
    "test:storage:web": "pnpm --filter api exec tsx ../../scripts/secure-store-web-test.ts",
    "test:expo-go-config": "node scripts/expo-go-config-test.cjs",
    "dev:android": "pnpm --parallel --filter api dev & pnpm go:android",
    "dev:android:reset": "pnpm --parallel --filter api dev & pnpm go:restart",
    "mobile:clean-go": "pnpm go:restart",
    "eval:top-failures": "node scripts/evals/top-failures-report.mjs",
    "eval:checkpoint": "node scripts/evals/checkpoint-gate.mjs"
  },
  "dependencies": {
    "metro-runtime": "^0.83.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0"
  }
}
