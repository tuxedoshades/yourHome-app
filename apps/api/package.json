{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test:email-security": "tsx scripts/email-security-contract.ts",
    "test:jwt-security": "tsx scripts/jwt-security-contract.ts",
    "test:s3-security": "node scripts/s3-security-supervisor-test.cjs && node scripts/s3-security-supervisor.cjs",
    "test:static-file-security": "tsx scripts/static-file-security-contract.ts",
    "test:prisma-config": "node scripts/prisma7-config-test.cjs",
    "test:prisma": "pnpm build && node scripts/smoke-supervisor.cjs --prisma-contract-only",
    "test:prisma:worker": "tsx scripts/prisma-contract.ts",
    "test:prisma:read": "pnpm prisma:generate && tsx --env-file=.env scripts/prisma-read-contract.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "pnpm prisma:generate && prisma db seed",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:disposable": "pnpm build && node scripts/smoke-supervisor.cjs",
    "seed:demo": "pnpm prisma:generate && tsx --env-file=.env scripts/seed-demo.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.1",
    "@fastify/static": "^10.1.2",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.3",
    "pg": "8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
