{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "cross-env YOURHOME_EXPO_GO=1 expo start --tunnel --go",
    "android:open": "cross-env YOURHOME_EXPO_GO=1 expo start --android --go",
    "android:devclient": "expo start --dev-client",
    "web": "expo start --web",
    "build": "node ../../scripts/build-mobile.mjs",
    "build:ios:devclient": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:devclient": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@rnmapbox/maps": "^10.2.10",
    "expo": "~55.0.28",
    "expo-auth-session": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "^55.0.37",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "leaflet": "^1.9.4",
    "metro-runtime": "^0.83.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.83.6",
    "react-native-maps": "^1.27.2",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.12",
    "@types/react": "~19.2.17",
    "cross-env": "^7.0.3",
    "eas-cli": "21.0.2",
    "typescript": "~5.9.3"
  }
}
