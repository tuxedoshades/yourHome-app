{
  "expo": {
    "name": "yourHome",
    "slug": "yourhome",
    "scheme": "yourhome",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#87A96B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourhome.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourhome.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#87A96B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "019f9763-df54-47b5-acbb-dec95f0b3bec"
      }
    },
    "runtimeVersion": "0.1.0-sdk55",
    "updates": {
      "url": "https://u.expo.dev/019f9763-df54-47b5-acbb-dec95f0b3bec"
    }
  }
}
